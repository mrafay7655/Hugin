{
  "name": "functions",
  "private": true,
  "type": "commonjs",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:int": "node ../scripts/free-emulator-ports.mjs && cd .. && firebase emulators:exec --only firestore --project demo-hugin \"cd functions && npx vitest run --config vitest.int.config.mts\""
  },
  "dependencies": {
    "@google-cloud/storage": "^8.4.0",
    "@google/adk": "^2.2.1",
    "@google/genai": "^2.28.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^26.6.4",
    "firebase": "^13.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
