# Non-secret function parameters. Copy to .env.<project-id> (for example .env.hugin-b1ff5) before deploying,
# or to .env.local for the emulators. Real secrets never go in a file: they are set in Secret Manager with
#   firebase functions:secrets:set WHATSAPP_TOKEN        (and the others listed in the README)

# The organization this deployment serves.
ORG_ID=ravenwood

# The WhatsApp Business phone number ID (an identifier, not a secret). Leave empty to run without WhatsApp.
WHATSAPP_PHONE_NUMBER_ID=

# Gemini on Vertex AI. "off" runs the agent on rules only (emulators and tests).
GEMINI_MODE=vertex
GEMINI_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# Optional: keep instances warm for the agent and the comment test, so judges never hit a cold start (10+ s).
# Raises the monthly bill; deploying then needs `firebase deploy --force`.
# HUGIN_WARM_INSTANCES=1

# Optional: how many Telegram messages the whole bot accepts per day (default 1500).
# TELEGRAM_DAILY_LIMIT=1500
